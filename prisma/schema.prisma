// Postgres holds only user/stateful data. The content graph (tracks, modules,
// lessons, exercises, assessments) is code-defined and referenced here by
// string IDs.

generator client {
  provider        = "prisma-client-js"
  // Driver adapters: on Cloudflare Workers the client runs through
  // @prisma/adapter-pg over the Hyperdrive binding (see src/lib/db.ts). Keep
  // the default output dir — @opennextjs/cloudflare patches the generated
  // client at build and can't if output is customized.
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  // PlanetScale for Postgres. In prod the connection comes from the Hyperdrive
  // binding, not this env var. DATABASE_URL is for local dev only: the *pooled*
  // string (PgBouncer, port 6432) in .env. Schema migrations live in
  // db/migrations and are applied manually with psql against the *direct* port
  // (5432, admin role) — never by `prisma migrate` against prod.
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  workosUserId  String   @unique
  email         String
  name          String?
  imageUrl      String?
  createdAt     DateTime @default(now())
  // Which OpenRouter key the grader bills: "server", "user", or
  // "classroom:<classroomId>". Null = automatic (own key, else a sole
  // available classroom key, else the server-wide key). Validated on write
  // and re-validated at grade time — a stale value falls back to automatic.
  graderKeyPref String?

  lessonProgress    LessonProgress[]
  submissions       Submission[]
  memberships       ClassroomMembership[]
  createdClassrooms Classroom[]           @relation("ClassroomCreatedBy")
  apiKeys           UserApiKey[]
  reviewCards       ReviewCard[]
  highlights        Highlight[]
}

// A user's text highlight on a paper item, with an optional attached note.
// Anchoring is sentence-granular on the artifact annotation contract:
// blockAnchor ("b-NNNN") + a data-s range, with the normalized selection
// text (capped) stored as snippet. The snippet is the source of truth at
// render time — the client paints only where the resolved range's text
// still matches it, so artifact rebuilds orphan highlights instead of
// misplacing them (artifactKey + convVersion record what the anchor was
// captured against). Length caps are enforced in the action AND as SQL
// CHECKs (see db/migrations); counts are capped per (user, item) and per
// user in src/app/actions/highlights.ts.
model Highlight {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentId   String // paper content id — validated against the graph, no FK
  // One gesture = one group: a multi-paragraph selection stores one row per
  // touched block, all sharing a groupId (single-block rows are a group of
  // one). The note lives on the group's HEAD row (first span in document
  // order); delete is by group.
  groupId     String
  artifactKey String // source artifact id (e.g. "2312.06942v5"), derived server-side
  convVersion Int // data-conv at capture time
  blockAnchor String
  sStart      Int
  sEnd        Int
  // Character offsets into the edge sentences' NORMALIZED text (partial-word
  // spans): startOffset 0 = sentence start; endOffset -1 = "to the end of
  // sEnd" (HIGHLIGHT_END_OF_SENTENCE — a sentinel, so whole-sentence rows
  // stay one canonical shape and pre-offset rows read unchanged).
  startOffset Int      @default(0)
  endOffset   Int      @default(-1)
  snippet     String
  note        String?
  color       String? // reserved — v1 renders a single color
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Serves every (userId, contentId) page-load read as a prefix AND blocks
  // exact-duplicate flooding of one span. Named: the seven-column default
  // identifier would exceed Postgres's 63-char limit.
  @@unique([userId, contentId, blockAnchor, sStart, sEnd, startOffset, endOffset], name: "userSpan", map: "Highlight_user_span_key")
}

// A user-supplied LLM-provider API key (currently only OpenRouter, for the
// reasoning-transparency grader). The key itself is stored AES-GCM-encrypted
// under API_KEY_ENCRYPTION_SECRET (src/lib/grader/key-crypto.ts); only the
// last four characters are kept in the clear for display. Key material never
// leaves the server.
model UserApiKey {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String   @default("openrouter")
  ciphertext String
  last4      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, provider])
}

// A classroom-supplied OpenRouter key: an instructor stores one so grading
// can bill the classroom instead of the student or the server. Same
// encryption scheme as UserApiKey, with the AAD bound to the classroom row
// (classroom:<classroomId>:<provider> — see src/lib/grader/grading-key.ts).
// Any classroom member may grade with it; only instructors manage it.
model ClassroomApiKey {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  provider    String    @default("openrouter")
  ciphertext  String
  last4       String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([classroomId, provider])
}

enum ProgressStatus {
  not_started // reserved — never written; absence of a row means not-started
  in_progress
  completed
}

model LessonProgress {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId     String
  status       ProgressStatus @default(in_progress)
  completedAt  DateTime?
  lastViewedAt DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  // No separate @@index([userId]): it is a strict prefix of the unique above,
  // which Postgres already uses for every userId / userId+lessonId predicate.

  @@unique([userId, lessonId])
}

enum SubmissionKind {
  exercise
  assessment
}

enum SubmissionStatus {
  draft
  submitted
  graded // reserved for the planned instructor/automated feedback flow
}

model Submission {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentId    String
  kind         SubmissionKind
  format       String?
  // closed-ended answers (selected option ids) or sectioned writing values
  responseJson Json?
  responseText String?
  status       SubmissionStatus @default(draft)
  score        Float?
  feedback     String? // reserved for the planned feedback flow (with status=graded)
  version      Int              @default(1) // reserved — not yet used for revision history
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  // No separate @@index([userId, contentId]): it is a strict prefix of the
  // unique above, which serves every Submission predicate in the app.

  @@unique([userId, contentId, kind])
}

// Per-user FSRS scheduling state for one tap-reveal "notecard" (contentId is
// the exercise's string id in the code-defined content graph, like
// Submission.contentId). A row is created the first time the learner
// self-rates the card inside a lesson (recordTapReveal) and re-scheduled by
// every review on the /review tab. Columns mirror the ts-fsrs Card fields
// (src/lib/review/fsrs.ts owns the mapping); `state` is the ts-fsrs State
// enum ordinal (0 New, 1 Learning, 2 Review, 3 Relearning).
model ReviewCard {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentId     String
  due           DateTime  @default(now())
  stability     Float     @default(0)
  difficulty    Float     @default(0)
  elapsedDays   Float     @default(0)
  scheduledDays Float     @default(0)
  learningSteps Int       @default(0)
  reps          Int       @default(0)
  lapses        Int       @default(0)
  state         Int       @default(0)
  lastReview    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // No separate @@index([userId]): strict prefix of the unique above, which
  // serves the per-user scan; due-ordering is a sort over one user's cards.

  @@unique([userId, contentId])
}

enum ClassroomRole {
  instructor
  student
}

model Classroom {
  id          String   @id @default(cuid())
  name        String
  joinCode    String   @unique
  trackId     String?
  createdById String
  createdBy   User     @relation("ClassroomCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  memberships ClassroomMembership[]
  apiKeys     ClassroomApiKey[]
}

model ClassroomMembership {
  id          String        @id @default(cuid())
  classroomId String
  classroom   Classroom     @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        ClassroomRole @default(student)
  joinedAt    DateTime      @default(now())

  @@unique([classroomId, userId])
  @@index([userId])
}
